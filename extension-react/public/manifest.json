{
  "manifest_version": 3,
  "name": "Boner Mohis — Prepaid Electricity Meter Genius",
  "version": "1.0.0",
  "description": "Tracks prepaid electricity meter balance and warns before it runs out.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://prepaid.desco.org.bd/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
